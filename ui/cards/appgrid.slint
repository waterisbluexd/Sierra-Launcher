import { Theme } from "../theme.slint";

export struct AppEntry {
    name: string,
    initial: string,
    icon: image,
    has-icon: bool,
}

export component AppGrid inherits Rectangle {
    in property <[AppEntry]> apps: [];
    in property <int> columns: 5;
    in property <int> rows: 2;

    callback launch(string);
    callback show-all();
    callback focus-appgrid();

    property <int> selected-index: -1;

    forward-focus: focus-scope;

    clip: true;

    property <length> gap: 12px;
    property <length> frame-padding: 12px;
    property <length> tile-width: (root.width - 2 * root.frame-padding - (root.columns - 1) * root.gap) / root.columns;
    property <length> tile-height: root.tile-width;
    property <length> tile-diag: root.tile-width + root.tile-height;
    property <length> header-height: 22px;
    property <int> slot-count: root.columns * root.rows;

    height: root.header-height + 10px
        + 2 * root.frame-padding
        + root.rows * root.tile-height
        + (root.rows - 1) * root.gap;

    background: transparent;

    Text {
        x: 0px;
        y: 0px;
        height: root.header-height;
        text: "Applications";
        font-family: "Monocraft";
        color: Theme.color7.with-alpha(0.5);
        font-size: 11px;
        letter-spacing: 1px;
        vertical-alignment: center;
    }

    all-apps-touch := TouchArea {
        x: parent.width - 100px;
        y: 0px;
        width: 100px;
        height: root.header-height;

        clicked => {
            root.show-all();
        }

        Text {
            width: parent.width;
            height: parent.height;
            text: "All Apps";
            font-family: "Monocraft";
            color: Theme.color7.with-alpha(all-apps-touch.has-hover ? 0.9 : 0.5);
            font-size: 11px;
            letter-spacing: 1px;
            horizontal-alignment: right;
            vertical-alignment: center;
            animate color {
                duration: 120ms;
            }
        }
    }

    focus-scope := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if event.text == Key.Return && root.selected-index >= 0 && root.selected-index < root.apps.length {
                root.launch(root.apps[root.selected-index].name);
            } else if event.text == Key.LeftArrow && root.selected-index > 0 {
                root.selected-index = root.selected-index - 1;
            } else if event.text == Key.RightArrow && root.selected-index < root.apps.length - 1 {
                root.selected-index = root.selected-index + 1;
            } else if event.text == Key.UpArrow && root.selected-index >= root.columns {
                root.selected-index = root.selected-index - root.columns;
            } else if event.text == Key.DownArrow && root.selected-index + root.columns < root.apps.length {
                root.selected-index = root.selected-index + root.columns;
            }

            accept
        }

        Rectangle {
            y: root.header-height + 10px;
            width: parent.width;
            height: 2 * root.frame-padding
                + root.rows * root.tile-height
                + (root.rows - 1) * root.gap;
            background: Theme.background.with-alpha(0.2);
            clip: true;

            for index in root.slot-count: tile := Rectangle {
                visible: index < root.apps.length;

                x: root.frame-padding
                    + Math.mod(index, root.columns) * (root.tile-width + root.gap);

                y: root.frame-padding
                    + Math.floor(index / root.columns) * (root.tile-height + root.gap);

                width: root.tile-width;
                height: root.tile-height;

                border-width: root.selected-index == index ? 2px : 0px;
                border-color: Theme.color4;

                background: tile-touch.has-hover
                    ? Theme.color4.with-alpha(0.10)
                    : transparent;

                animate background {
                    duration: 150ms;
                    easing: ease-out;
                }

                animate border-width {
                    duration: 120ms;
                }

                tile-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;

                    clicked => {
                        root.selected-index = index;
                        root.launch(root.apps[index].name);
                    }
                }

                if root.apps[index].has-icon: Image {
                    width: 34px;
                    height: 34px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: root.apps[index].icon;
                }

                if !root.apps[index].has-icon: Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.apps[index].initial;
                    color: tile-touch.has-hover
                        ? Theme.color4
                        : Theme.color4.with-alpha(0.85);
                    font-family: "Monocraft";
                    font-size: 20px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;

                    animate color {
                        duration: 120ms;
                    }
                }
            }
        }
    }

    focus-appgrid => {
        focus-scope.focus();

        if root.selected-index < 0 && root.apps.length > 0 {
            root.selected-index = 0;
        }
    }
}
