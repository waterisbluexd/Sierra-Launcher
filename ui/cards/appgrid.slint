import { Theme } from "../theme.slint";

export struct AppEntry {
    name: string,
    initial: string,
    icon: image,
    has-icon: bool,
}

export component AppGrid inherits Rectangle {
    in property <[AppEntry]> apps: [];
    in property <int> columns: 5;

    callback launch(string);
    callback show-all();

    property <length> tile-width: 68px;
    property <length> tile-height: 78px;
    property <length> gap: 8px;
    property <length> header-height: 22px;

    property <int> rows:
        root.apps.length == 0
            ? 0
            : (root.apps.length + root.columns - 1) / root.columns;

    width: 100%;
    height: root.header-height
        + root.rows * root.tile-height
        + max(0, root.rows - 1) * root.gap
        + 12px;

    background: transparent;

    Text {
        width: parent.width;
        height: parent.height;
        text: "Applications";
        font-family: "Monocraft";
        color: Theme.color7.with-alpha(1.0);
        font-size: 13px;
        horizontal-alignment: left;
        vertical-alignment: center;
    }

    TouchArea {
        x: parent.width - 75px;
        y: 0px;
        width: 75px;
        height: root.header-height;

        clicked => {
            root.show-all();
        }

        Text {
            width: parent.width;
            height: parent.height;
            text: "All apps →";
            font-family: "Monocraft";
            color: Theme.color7.with-alpha(0.65);
            font-size: 13px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    for app[index] in root.apps: Rectangle {
        x: Math.mod(index, root.columns) * (root.tile-width + root.gap);
        y: root.header-height
            + (index / root.columns) * (root.tile-height + root.gap);

        width: root.tile-width;
        height: root.tile-height;

        background: tile-touch.has-hover
            ? Theme.color4.with-alpha(0.14)
            : Theme.color4.with-alpha(0.07);

        border-width: 1px;

        border-color: tile-touch.has-hover
            ? Theme.color7.with-alpha(0.32)
            : Theme.color7.with-alpha(0.12);

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            tile-touch := TouchArea {
                clicked => {
                    root.launch(app.name);
                }
            }

            VerticalLayout {
                spacing: 3px;

                Rectangle {
                    width: parent.width;
                    height: 50px;
                    background: transparent;

                    if app.has-icon: Image {
                        width: 38px;
                        height: 38px;
                        source: app.icon;
                    }

                    if !app.has-icon: Text {
                        width: parent.width;
                        height: parent.height;
                        text: app.initial;
                        color: Theme.color4;
                        font-size: 22px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    width: parent.width;
                    height: 20px;
                    text: app.name;
                    color: Theme.color4;
                    font-size: 10px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
