import { Theme } from "../theme.slint";
import { WallpaperCarousel } from "../cards/wallpaper.slint";
import { SearchBar } from "../cards/searchbar.slint";
import { Clock } from "../cards/clock.slint";
import { Weather } from "../cards/weather.slint";
import { AppGrid, AppEntry } from "../cards/appgrid.slint";

export component TopSection inherits Rectangle {
    height: 630px;
    border-width: 0px;
    background: transparent;
    clip: true;

    in property <image> wallpaper-image;
    in property <image> wallpaper-image-blurred;
    in property <image> wallpaper-prev-image;
    in property <image> wallpaper-next-image;
    in property <image> wallpaper-prev-prev-image;
    in property <image> wallpaper-next-next-image;

    in property <int> wallpaper-current-index: 0;
    in property <int> wallpaper-total-count: 1;

    in property <bool> can-select-prev: true;
    in property <bool> can-select-next: true;

    in property <string> current-time: "00:00";
    in property <string> current-date: "01 Jan, Monday";
    in property <string> current-greeting: "Good evening, User!";

    in property <bool> is-rainy: false;
    in property <bool> is-cloudy: false;
    in property <bool> is-clear: false;
    in property <bool> is-day: true;

    in property <string> temperature: "";
    in property <string> condition: "";

    in property <[AppEntry]> apps: [];

    callback select-prev();
    callback select-next();
    callback search-edited(string);
    callback search-accepted(string);
    callback focus-search();
    callback launch-app(string);
    callback show-all-apps();

    focus-search => {
        search-bar.focus();
    }

    carousel := WallpaperCarousel {
        width: 100%;
        height: 100%;

        wallpaper-image: root.wallpaper-image;
        wallpaper-prev-image: root.wallpaper-prev-image;
        wallpaper-next-image: root.wallpaper-next-image;
        wallpaper-prev-prev-image: root.wallpaper-prev-prev-image;
        wallpaper-next-next-image: root.wallpaper-next-next-image;
        wallpaper-image-blurred: root.wallpaper-image-blurred;

        wallpaper-current-index: root.wallpaper-current-index;
        wallpaper-total-count: root.wallpaper-total-count;

        can-select-prev: root.can-select-prev;
        can-select-next: root.can-select-next;

        select-prev => {
            root.select-prev();
        }

        select-next => {
            root.select-next();
        }
    }

    VerticalLayout {
        y: 0px;
        width: parent.width;
        padding-top: 25px;
        padding-bottom: -20px;
        spacing: 0px;

        opacity: carousel.selection-mode ? 0 : 1;

        animate opacity {
            duration: 200ms;
            easing: ease-in-out;
        }

        HorizontalLayout {
            width: parent.width;
            alignment: start;
            padding-left: 25px;
            padding-top: 15px;
            padding-bottom: -20px;
            spacing: 60px;

            Clock {
                time: root.current-time;
                date: root.current-date;
                greeting: root.current-greeting;
                time-font-size: 56px;
            }

            Weather {
                icon-size: 100px;
                y: 100px;

                is-rainy: root.is-rainy;
                is-cloudy: root.is-cloudy;
                is-clear: root.is-clear;
                is-day: root.is-day;

                temperature: root.temperature;
                condition: root.condition;
            }
        }

        HorizontalLayout {
            width: parent.width;
            padding-left: 20px;
            padding-right: 20px;

            search-bar := SearchBar {
                edited(t) => {
                    root.search-edited(t);
                }

                accepted(t) => {
                    root.search-accepted(t);
                }
            }
        }

        VerticalLayout {
            width: parent.width;
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 10px;
            spacing: 0px;

            AppGrid {
                width: parent.width;
                apps: root.apps;

                launch(name) => {
                    root.launch-app(name);
                }

                show-all() => {
                    root.show-all-apps();
                }
            }
        }
    }
}
